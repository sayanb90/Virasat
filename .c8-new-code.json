{
  "//": "The gate for code written from phase 2 on (npm run test:coverage). Each file must keep this coverage on its own. Older code is reported by .c8rc.json but not gated yet.",
  "temp-directory": "coverage/.tmp",
  "include": [
    "lib/device/der.ts",
    "lib/device/keyops.ts",
    "lib/device/native.ts",
    "lib/device/core.ts",
    "lib/device/bridge.ts",
    "lib/device/useBiometrics.ts",
    "lib/native/reloadToRoot.ts",
    "lib/routes.ts",
    "lib/config.ts",
    "proxy.ts",
    "next.config.ts",
    "scripts/serve-static.mjs",
    "lib/auth/providers/native.ts",
    "lib/auth/providers/index.ts",
    "lib/auth/socialSheets.ts"
  ],
  "per-file": true,
  "lines": 100,
  "functions": 100,
  "branches": 95,
  "statements": 100
}
