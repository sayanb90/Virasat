# ─────────────────────────────────────────────────────────────────────────────
# Virasat — environment
#
# Copy to .env.local and fill in. Everything here is optional: with none of it
# set, the app runs and email goes to the server log instead of the wire.
# ─────────────────────────────────────────────────────────────────────────────

# Which email transport to use: console | resend | sendgrid
# `console` (the default) sends nothing and prints the message to the log, so a
# half-configured deployment cannot quietly post a real address to a provider.
EMAIL_DRIVER=console

# The From address on every email. Required for real sends, and the domain must
# be one you have verified with your provider or mail will be rejected or
# land in spam.
# EMAIL_FROM="Virasat <hello@yourdomain.com>"

# Absolute base URL used to build links in emails. Without it, links point at
# http://localhost:3000, which is right in development and wrong anywhere else.
# APP_URL=https://yourdomain.com


# ── Provider credentials — set only the one matching EMAIL_DRIVER ───────────
# RESEND_API_KEY=re_...
# SENDGRID_API_KEY=SG....

# ── Billing ─────────────────────────────────────────────────────────────────
# Which billing transport to use: stub | razorpay
# `stub` (the default) moves no money and talks to nobody, so an
# unconfigured deployment cannot half-charge a real customer.
BILLING_DRIVER=stub

# Razorpay, when BILLING_DRIVER=razorpay. The key id is public — the browser
# checkout needs it. The other two never leave the server.
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=...
# Set separately under Settings → Webhooks in the Razorpay dashboard. This is
# NOT the API key secret, and test and live mode have different values.
# RAZORPAY_WEBHOOK_SECRET=...

# Lets the specs sign stub webhooks. No effect with any other driver.
# STUB_WEBHOOK_SECRET=stub-webhook-secret

# ── Sign-in ─────────────────────────────────────────────────────────────────
# Which Apple / Google / Facebook driver to use: stub | native
# `stub` (the default) shows a test sheet and talks to no provider. It refuses
# to run in a production build, so it cannot reach a real deployment.
# `native` is not built yet and reports itself not ready.
AUTH_PROVIDERS_DRIVER=stub

# Keys the stable fake salts handed out for unknown emails, so prelogin does
# not reveal who has an account. Random per process when unset, which is only
# right while accounts are in memory. Set it once persistence lands.
# AUTH_SERVER_SECRET=...

# ── Internal ────────────────────────────────────────────────────────────────
# Set to 1 ONLY by the Playwright config. It opens /api/test/reset,
# /api/test/codes, /api/test/clock and /api/scheduler (the last of which can
# release the vault), and allows the stub sign-in provider in a production
# build. Never set this in a deployment.
# VIRASAT_E2E=1
