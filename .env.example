# ─────────────────────────────────────────────────────────────────────────────
# Virasat — environment
#
# Copy to .env.local and fill in. Everything here is optional: with none of it
# set, the app runs and email goes to the server log instead of the wire.
# ─────────────────────────────────────────────────────────────────────────────

# Which email transport to use: console | resend | sendgrid
# `console` (the default) sends nothing and prints the message to the log, so a
# half-configured deployment cannot quietly post a real address to a provider.
EMAIL_DRIVER=console

# The From address on every email. Required for real sends, and the domain must
# be one you have verified with your provider or mail will be rejected or
# land in spam.
# EMAIL_FROM="Virasat <hello@yourdomain.com>"

# Absolute base URL used to build links in emails. Without it, links point at
# http://localhost:3000, which is right in development and wrong anywhere else.
# APP_URL=https://yourdomain.com


# Development and staging only: deliver every email to this one address,
# with the intended recipient in the subject. For a provider sandbox that only
# sends to its own account (Resend's onboarding@resend.dev).
# EMAIL_REDIRECT_TO=you@gmail.com

# ── Provider credentials — set only the one matching EMAIL_DRIVER ───────────
# RESEND_API_KEY=re_...
# SENDGRID_API_KEY=SG....

# ── Builds: the app and the API ─────────────────────────────────────────────
# One repo, two deployments (next.config.ts). Development needs none of this:
# with BUILD_TARGET unset, the app and /api run together on one origin.
#
#   npm run build:app   the UI as a static export in out/, which the native
#                       app ships inside its bundle
#   npm run build:api   the API host: /api, plus the few pages a browser opens
#                       from an email link
#
# Build-time, for the app build: where the API lives. Inlined into the
# bundle, so it must be set when building, not when running.
# NEXT_PUBLIC_API_BASE=https://api.yourdomain.com
#
# The build the iOS and Android apps carry: `npm run build:native` sets
# NEXT_PUBLIC_NATIVE=1 itself (hardware keys, no browser fallback). Do not
# set it here: a browser build with it set cannot open at all.
#
# On the API host, APP_URL above must be the API host too: emailed links open
# in a browser, and the API host is the only web server there is.
#
# Extra origins the API host accepts cross-origin requests from, comma
# separated. The native app's origins (capacitor://localhost, https://localhost)
# are always allowed. This exists for the split-mode test harness — leave it
# UNSET in production.
# CORS_ALLOWED_ORIGINS=http://127.0.0.1:3398

# ── Billing ─────────────────────────────────────────────────────────────────
# Which billing transport to use: stub | razorpay
# `stub` (the default) moves no money and talks to nobody, so an
# unconfigured deployment cannot half-charge a real customer.
BILLING_DRIVER=stub

# Razorpay, when BILLING_DRIVER=razorpay. The key id is public — the browser
# checkout needs it. The other two never leave the server.
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=...
# Set separately under Settings → Webhooks in the Razorpay dashboard. This is
# NOT the API key secret, and test and live mode have different values.
# RAZORPAY_WEBHOOK_SECRET=...

# Lets the specs sign stub webhooks. No effect with any other driver.
# STUB_WEBHOOK_SECRET=stub-webhook-secret

# ── Sign-in ─────────────────────────────────────────────────────────────────
# Which Apple / Google / Facebook driver to use: stub | native
# `stub` (the default) shows a test sheet and talks to no provider. It refuses
# to run in a production build, so it cannot reach a real deployment.
# `native` checks real tokens (lib/auth/providers/native.ts). Each provider is
# off until its ids are set; with none set, social sign-in answers 503.
AUTH_PROVIDERS_DRIVER=stub
# APPLE_CLIENT_IDS=com.virasat.app
# GOOGLE_CLIENT_IDS=xxxx-ios.apps.googleusercontent.com,xxxx-web.apps.googleusercontent.com
# FACEBOOK_APP_ID=...
# FACEBOOK_APP_SECRET=...
# FACEBOOK_GRAPH_VERSION=v23.0
#
# The app's own sheets (build-time, for `npm run build:native`). The Google
# web client id must also be in GOOGLE_CLIENT_IDS: Android's tokens carry it.
# NEXT_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxx-ios.apps.googleusercontent.com
# NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx-web.apps.googleusercontent.com
# NEXT_PUBLIC_FACEBOOK_APP_ID=...
# NEXT_PUBLIC_FACEBOOK_CLIENT_TOKEN=...

# ── Limits per network ──────────────────────────────────────────────────────
# Where the API host finds the client's address (lib/auth/rateLimit.ts), and
# how many proxies in front of it append to that header. Behind one proxy
# that appends to X-Forwarded-For, the defaults are right.
# CLIENT_IP_HEADER=x-forwarded-for
# TRUSTED_PROXY_HOPS=1

# ── Alerts on the Owner's phones ────────────────────────────────────────────
# console (the default) logs what it would send. native: APNs and FCM.
PUSH_DRIVER=console
# APNS_KEY_P8="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APNS_KEY_ID=...
# APNS_TEAM_ID=...
# APNS_TOPIC=com.virasat.app
# APNS_SANDBOX=1
# FCM_SERVICE_ACCOUNT_JSON={"project_id":"...","client_email":"...","private_key":"..."}

# Keys the stable fake salts handed out for unknown emails, so prelogin does
# not reveal who has an account. Random per process when unset, which is only
# right while accounts are in memory. Set it once persistence lands.
# AUTH_SERVER_SECRET=...

# ── Internal ────────────────────────────────────────────────────────────────
# Set to 1 ONLY by the Playwright config. It opens /api/test/reset,
# /api/test/codes, /api/test/clock and /api/scheduler (the last of which can
# release the vault), and allows the stub sign-in provider in a production
# build. Never set this in a deployment.
# VIRASAT_E2E=1

# ── Development data ────────────────────────────────────────────────────────
# Save every store to this JSON file and load it at start, so a restart keeps
# accounts and vaults. One process only; not a database (docs/runbook.md §2).
# DATA_FILE=data/mock-db.json
#
# Defaults for `npm run db:mock` (docs/runbook.md §8.1).
# SEED_INBOX=you@gmail.com
# SEED_PASSWORD=
